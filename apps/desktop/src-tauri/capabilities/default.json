{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Main window: core events/window APIs only. App commands are allow-listed in build.rs.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "allow-backend-connection",
    "allow-backend-status",
    "allow-restart-backend",
    "allow-sync-tray",
    "allow-ptt-shortcut",
    "autostart:allow-enable",
    "autostart:allow-disable",
    "autostart:allow-is-enabled"
  ]
}
